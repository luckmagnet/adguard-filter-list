{
  "name": "luckmagnet/adguard-filter-list",
  "description": "DNS block list that can be used for AdGuardHome. (Does not work with Pi-hole)",
  "homepage": "https://github.com/luckmagnet/adguard-filter-list",
  "license": "GPLv3",
  "sources": [
    {
      "name": "HaGeZi's Multi ULTIMATE",
      "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/ultimate.txt",
      "type": "adblock",
      "transformations": [
        "RemoveComments",
        "Compress",
        "Validate"
      ]
    },
  ],
  "transformations": [
    "RemoveComments",
    "Deduplicate",
    "TrimLines",
    "InsertFinalNewLine",
    "RemoveEmptyLines"
  ]
}
